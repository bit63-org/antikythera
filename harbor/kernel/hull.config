#
# hull: the strict host kernel (.kiro/specs/hull-host-agent/ Requirement 2).
# Applied on top of `make allnoconfig` together with the per-arch fragment
# (x86_64.config); harbor/kernel/build.sh does both and then checks the
# resolved .config with harbor/kernel/check-config.py, which fails if an
# option below did not survive Kconfig dependency resolution or if
# anything Requirement 2.3 forbids came back.
#
# Everything is built in: there are no modules, so nothing can be loaded
# after boot and the whole kernel is covered by the UKI signature.
#
# The command line (Requirement 2.4: IOMMU strict, pci=noats, 1 GiB pages,
# isolated guest cores) depends on the machine and lives in the UKI
# (hull task 10). The defaults below make the safe choice when it is
# missing: the IOMMU is on and strict without any command line.

# --- Base system -----------------------------------------------------------
CONFIG_LOCALVERSION="-hull"
CONFIG_DEFAULT_HOSTNAME="hull"
# CONFIG_MODULES is not set
# EXPERT unlocks the prompts allnoconfig cannot otherwise turn off
# (BLOCK, VT, INPUT); without it they stay at their default of y.
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_IO_URING=y
# Off by default under EXPERT; Cloud Hypervisor and glibc use them.
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_PROC_SYSCTL=y
CONFIG_KALLSYMS=y
CONFIG_BINFMT_ELF=y
# No shell, no scripts (hull design: init is a static binary).
# CONFIG_BINFMT_SCRIPT is not set
CONFIG_SMP=y
# KVM depends on high-resolution timers.
CONFIG_HIGH_RES_TIMERS=y

# --- Initramfs and pseudo filesystems --------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_HUGETLBFS=y
# No block layer: the host owns no disks (volumes are oar-blk functions
# passed through to guests), and the initramfs needs none.
# CONFIG_BLOCK is not set

# --- Console (Requirement 2.2) ---------------------------------------------
CONFIG_TTY=y
# CONFIG_VT is not set

# --- Networking: AF_UNIX only (Requirements 2.2, 2.3) ----------------------
# Cloud Hypervisor's API socket is the only socket the host needs.
CONFIG_NET=y
CONFIG_UNIX=y
# CONFIG_INET is not set
# CONFIG_NETDEVICES is not set
# CONFIG_WIRELESS is not set

# --- Jail: namespaces, cgroups, Landlock, seccomp (hull task 7) ------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock"
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- Core isolation for guest vCPUs (Requirement 2.4) ----------------------
CONFIG_CPU_ISOLATION=y
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y

# --- PCIe (Requirement 2.2, 2.3) -------------------------------------------
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_PCIE_DPC=y
CONFIG_PCI_IOV=y
# Slots change only under helm's control; the host never reacts to
# presence-detect on its own.
# CONFIG_HOTPLUG_PCI is not set
# CONFIG_HOTPLUG_PCI_PCIE is not set

# --- IOMMU (Requirement 2.2) -----------------------------------------------
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y

# --- VFIO (Requirement 2.2) ------------------------------------------------
CONFIG_VFIO=y
CONFIG_VFIO_GROUP=y
CONFIG_VFIO_CONTAINER=y
CONFIG_VFIO_PCI=y

# --- Devices the host must never drive (Requirement 2.3) -------------------
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_INPUT is not set

# --- Hardening -------------------------------------------------------------
# kexec would replace the measured kernel without going through Secure Boot.
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_DEVMEM is not set
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
