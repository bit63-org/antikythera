#pragma once

// The controller public keys compiled into hull-agent (Requirement 4.1).
// CMake writes this header from src/hull/controller_keys.hpp.in and the
// cache variable AK_HULL_CONTROLLER_KEYS; edit the template, not the
// generated copy. parse_controller_keys() reads the text.

#include <string_view>

namespace ak::hull {

// A function rather than a variable so an empty list (the default) is not
// a "redundant" empty-string initializer to clang-tidy.
constexpr auto compiled_controller_keys() noexcept -> std::string_view { return "@AK_HULL_CONTROLLER_KEYS@"; }

}  // namespace ak::hull
