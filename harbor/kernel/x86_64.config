#
# hull kernel, x86_64 additions to hull.config: the parts of Requirement 2
# whose Kconfig symbols are per-architecture. Applied with ARCH=x86_64.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_ACPI=y
CONFIG_X86_X2APIC=y
CONFIG_RANDOMIZE_BASE=y

# --- Server topology and machine checks -------------------------------------
# The resource allocator (hull task 6) places whole cores and 1 GiB pages
# by SMT sibling and NUMA node.
CONFIG_NUMA=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y

# --- UEFI boot (the UKI is an EFI stub image, hull task 10) ----------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# --- Serial console --------------------------------------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- KVM (Requirement 2.2) -------------------------------------------------
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y

# --- IOMMU with interrupt remapping (Requirement 2.2) ----------------------
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y
CONFIG_IRQ_REMAP=y
