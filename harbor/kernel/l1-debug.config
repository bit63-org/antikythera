#
# harbor L1 debug kernel: hull.config + x86_64.config + this file.
# Permissive on purpose (.kiro/specs/harbor-virt-on-virt/ design): it adds
# IPv4, virtio disks and NIC, ext4 and a script interpreter so the hull
# kernel can boot harbor's Ubuntu L1 disk and be reached over SSH with
# QEMU user networking. Everything hull.config sets for KVM, the IOMMU,
# VFIO and PCIe stays as it is, so phases 1-5 exercise the same kernel
# paths as the strict image. Never ship this; phase 6 uses hull.config.

CONFIG_LOCALVERSION="-hull-l1debug"
CONFIG_BINFMT_SCRIPT=y

# --- IP for SSH and package installs ---------------------------------------
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y

# --- virtio disks: the qcow2 root and the cloud-init seed ------------------
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# --- What systemd needs from the kernel ------------------------------------
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_UNIX98_PTYS=y
