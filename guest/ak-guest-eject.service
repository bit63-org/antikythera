# Releases antikythera disks the host asks to detach, when nothing uses
# them (guest/ak-guest-eject). Started by 90-ak-guest-eject.rules when a
# virtio disk appears; enable it to run from boot as well.

[Unit]
Description=Release antikythera disks on cooperative detach
Documentation=https://github.com/bit63-org/antikythera/tree/main/guest

[Service]
ExecStart=/usr/local/sbin/ak-guest-eject
Restart=on-failure
# It reads PCI config space and /proc, and writes a device's sysfs remove.
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
